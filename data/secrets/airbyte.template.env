# This file only contains Docker relevant variables.## The only exception to the non-default rule are env vars related to scaling.## See https://github.com/airbytehq/airbyte/blob/master/airbyte-config/config-models/src/main/java/io/airbyte/config/Configs.java# for the latest environment variables.## # Contributors - please organise this env file according to the above linked file.

### SHARED ###VERSION= # Example: 0.50.5

# When using the airbyte-db via default docker imageCONFIG_ROOT= # Example: /data
DATA_DOCKER_MOUNT= # Example: airbyte_data
DB_DOCKER_MOUNT= # Example: airbyte_db

# Workspace storage for running jobs (logs, etc)WORKSPACE_ROOT= # Example: /tmp/workspace
WORKSPACE_DOCKER_MOUNT= # Example: airbyte_workspace

# Local mount to access local files from filesystem# todo (cgardens) - when we are mount raw directories instead of named volumes, *_DOCKER_MOUNT must# be the same as *_ROOT.# Issue: https://github.com/airbytehq/airbyte/issues/578LOCAL_ROOT= # Example: /tmp/airbyte_local
LOCAL_DOCKER_MOUNT= # Example: /tmp/airbyte_local
# todo (cgardens) - hack to handle behavior change in docker compose. *_PARENT directories MUST# already exist on the host filesystem and MUST be parents of *_ROOT.# Issue: https://github.com/airbytehq/airbyte/issues/577HACK_LOCAL_ROOT_PARENT= # Example: /tmp

# Proxy Configuration# Set to empty values, e.g. "" to disable basic authBASIC_AUTH_USERNAME= # Example: username
BASIC_AUTH_PASSWORD= # Example: Passw0rd
BASIC_AUTH_PROXY_TIMEOUT= # Example: 900

### DATABASE ###DATABASE_USER= # Example: username
DATABASE_PASSWORD= # Example: Passw0rd
DATABASE_HOST= # Example: db
DATABASE_PORT= # Example: 5432
DATABASE_DB= # Example: airbyte
DATABASE_URL= # Example: protocol://user:password@host:port/path
JOBS_DATABASE_MINIMUM_FLYWAY_MIGRATION_VERSION= # Example: 0.40.26.001

# Airbyte Internal Config Database, defaults to Job Database if empty. Explicitly left empty to mute docker compose warnings.CONFIG_DATABASE_USER= # Example: username
CONFIG_DATABASE_PASSWORD= # Example: Passw0rd
CONFIG_DATABASE_URL= # Example: protocol://user:password@host:port/path
CONFIGS_DATABASE_MINIMUM_FLYWAY_MIGRATION_VERSION= # Example: 0.40.23.002

### AIRBYTE SERVICES ###TEMPORAL_HOST= # Example: airbyte-temporal:7233
INTERNAL_API_HOST= # Example: airbyte-server:8001
CONNECTOR_BUILDER_API_HOST= # Example: airbyte-connector-builder-server:80
WEBAPP_URL= # Example: protocol://user:password@host:port/path
# Although not present as an env var, required for webapp configuration.CONNECTOR_BUILDER_API_URL= # Example: protocol://user:password@host:port/path

### JOBS #### Relevant to scaling.SYNC_JOB_MAX_ATTEMPTS= # Example: 3
SYNC_JOB_MAX_TIMEOUT_DAYS= # Example: 3
SYNC_JOB_INIT_RETRY_TIMEOUT_MINUTES= # Example: 5
JOB_MAIN_CONTAINER_CPU_REQUEST=
JOB_MAIN_CONTAINER_CPU_LIMIT=
JOB_MAIN_CONTAINER_MEMORY_REQUEST=
JOB_MAIN_CONTAINER_MEMORY_LIMIT=

NORMALIZATION_JOB_MAIN_CONTAINER_MEMORY_LIMIT=
NORMALIZATION_JOB_MAIN_CONTAINER_MEMORY_REQUEST=
NORMALIZATION_JOB_MAIN_CONTAINER_CPU_LIMIT=
NORMALIZATION_JOB_MAIN_CONTAINER_CPU_REQUEST=

### LOGGING/MONITORING/TRACKING ###TRACKING_STRATEGY= # Example: segment
JOB_ERROR_REPORTING_STRATEGY= # Example: logging
# Although not present as an env var, expected by Log4J configuration.LOG_LEVEL= # Example: INFO


### APPLICATIONS #### Worker #WORKERS_MICRONAUT_ENVIRONMENTS= # Example: control-plane
# Cron #CRON_MICRONAUT_ENVIRONMENTS= # Example: control-plane
# Relevant to scaling.MAX_SYNC_WORKERS= # Example: 5
MAX_SPEC_WORKERS= # Example: 5
MAX_CHECK_WORKERS= # Example: 5
MAX_DISCOVER_WORKERS= # Example: 5
MAX_NOTIFY_WORKERS= # Example: 5
SHOULD_RUN_NOTIFY_WORKFLOWS= # Example: true
# Temporal Activity configurationACTIVITY_MAX_ATTEMPT=
ACTIVITY_INITIAL_DELAY_BETWEEN_ATTEMPTS_SECONDS=
ACTIVITY_MAX_DELAY_BETWEEN_ATTEMPTS_SECONDS=
WORKFLOW_FAILURE_RESTART_DELAY_SECONDS=

### FEATURE FLAGS ###AUTO_DISABLE_FAILING_CONNECTIONS= # Example: false

FEATURE_FLAG_CLIENT= # Example: myhiddensecret

### MONITORING FLAGS #### Accepted values are datadog and otel (open telemetry)METRIC_CLIENT= # Example: myhiddensecret
OTEL_COLLECTOR_ENDPOINT= # Example: "http://host.docker.internal:4317"

USE_STREAM_CAPABLE_STATE= # Example: true
AUTO_DETECT_SCHEMA= # Example: true

# To test local catalog changes, set the below variable to the path of your local catalog.# https://docs.airbyte.com/connector-development/testing-connectors/testing-a-local-catalog-in-developmentLOCAL_CONNECTOR_CATALOG_PATH=
