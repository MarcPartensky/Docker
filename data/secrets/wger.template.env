# this instance publicly. For an online generator, see e.g. https://djecrety.ir/SECRET_KEY= # Example: myhiddenkey

SIGNING_KEY= # Example: myhiddenkey

# The server's timezone, for a list of possible names:TIME_ZONE= # Example: Europe/Paris

## Consult the deployment section in the readme if you are running this behind a# reverse proxy with HTTPS enabled
# CSRF_TRUSTED_ORIGINS=https://my.domain.example.com,https://118.999.881.119CSRF_TRUSTED_ORIGINS= # Example: https://wger.marcpartensky.com
# X_FORWARDED_PROTO_HEADER_SET=True
## Static files# mobile app)
## These settings usually don't need changing#
## ApplicationWGER_INSTANCE= # Example: https://wger.de
ALLOW_REGISTRATION= # Example: True
ALLOW_GUEST_USERS= # Example: username
ALLOW_UPLOAD_VIDEOS= # Example: myhiddenid
# lower than this amount in days.MIN_ACCOUNT_AGE_TO_TRUST= # Example: 21
# Synchronzing exercises# It is recommended to keep the local database synchronized with the wger# instance specified in WGER_INSTANCE since there are new added or translations# improved. For this you have different possibilities:# - Sync exercises on startup:# SYNC_EXERCISES_ON_STARTUP=True# DOWNLOAD_EXERCISE_IMAGES_ON_STARTUP=True# - Sync them in the background with celery. This will setup a job that will run#   once a week at a random time (this time is selected once when starting the server)SYNC_EXERCISES_CELERY= # Example: True
SYNC_EXERCISE_IMAGES_CELERY= # Example: True
SYNC_EXERCISE_VIDEOS_CELERY= # Example: myhiddenid
# - Manually trigger the process as needed:#   docker compose exec web python3 manage.py sync-exercises#   docker compose exec web python3 manage.py download-exercise-images
# Where to download ingredient and their images if they are not known locally.# Possible values OFF, WGER. Note that it is recommended to keep this as WGER# so that we don't overwhelm the Open Food Facts servers. Needs to have USE_CELERY# set to trueDOWNLOAD_INGREDIENTS_FROM= # Example: WGER

# Whether celery is configured and should be used. Can be left to true with# this setup but can be deactivated if you are using the app in some other wayUSE_CELERY= # Example: True

## CeleryCELERY_BROKER= # Example: redis://redis:6379/4
CELERY_BACKEND= # Example: redis://redis:6379/4
CELERY_FLOWER_PASSWORD= # Example: Passw0rd

## DatabaseDJANGO_DB_ENGINE= # Example: django.db.backends.postgresql
DJANGO_DB_DATABASE= # Example: wger
DJANGO_DB_USER= # Example: username
DJANGO_DB_PASSWORD= # Example: Passw0rd
DJANGO_DB_HOST= # Example: postgres
DJANGO_DB_PORT= # Example: 5432
# Perform any new database migrations on startupDJANGO_PERFORM_MIGRATIONS= # Example: True

## CacheDJANGO_CACHE_BACKEND= # Example: django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION= # Example: redis://redis:6379/3
# in seconds - 60*60*24*15, 15 DaysDJANGO_CACHE_TIMEOUT= # Example: 1296000
DJANGO_CACHE_CLIENT_CLASS= # Example: myhiddensecret

## Brute force login attacks# https://django-axes.readthedocs.io/en/latest/index.htmlAXES_ENABLED= # Example: True
AXES_FAILURE_LIMIT= # Example: 10
# in minutesAXES_COOLOFF_TIME= # Example: 30
AXES_HANDLER= # Example: axes.handlers.cache.AxesCacheHandler

## OthersDJANGO_DEBUG= # Example: True
WGER_USE_GUNICORN= # Example: True
# in seconds - 5*60*60, 5 hoursEXERCISE_CACHE_TTL= # Example: 3600
SITE_URL= # Example: protocol://user:password@host:port/path

## JWT authACCESS_TOKEN_LIFETIME= # Example: myhiddentoken
REFRESH_TOKEN_LIFETIME= # Example: myhiddentoken

## Other possible settings
# NOCAPTCHA
#FROM_EMAIL= # Example: user.name@gmail.com

